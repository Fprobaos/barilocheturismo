{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/pesca-con-mosca",
      "destination": "/paseo-en-lancha",
      "permanent": true
    },
    {
      "source": "/pesca-con-mosca.html",
      "destination": "/paseo-en-lancha",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(img|video|pano)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(og-image.jpg|favicon.ico|favicon.svg|apple-touch-icon.png|icon-192.png|icon-512.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
